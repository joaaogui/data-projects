{
  "name": "data-projects",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "pnpm test:unit",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "test:unit": "pnpm --filter @data-projects/shared --filter @data-projects/ui --filter clash-deck-advisor --filter lastfm-habits --filter spotify-popularity --filter youtube-analyzer run test && pnpm --filter imdb-best-season run test:unit"
  },
  "devDependencies": {
    "prettier": "catalog:",
    "turbo": "catalog:"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "protobufjs": ">=7.6.5 <8",
      "glob": "^13.0.6"
    }
  }
}