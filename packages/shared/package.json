{
  "name": "@data-projects/shared",
  "version": "0.0.1",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./ai-provider": {
      "types": "./src/ai-provider.ts",
      "default": "./src/ai-provider.ts"
    },
    "./db": {
      "types": "./src/db.ts",
      "default": "./src/db.ts"
    },
    "./env": {
      "types": "./src/env.ts",
      "default": "./src/env.ts"
    },
    "./eslint-config": {
      "default": "./src/eslint-config.mjs"
    },
    "./logger": {
      "types": "./src/logger.ts",
      "default": "./src/logger.ts"
    },
    "./next-headers": {
      "types": "./src/next-headers.d.ts",
      "default": "./src/next-headers.mjs"
    },
    "./route-handler": {
      "types": "./src/route-handler.ts",
      "default": "./src/route-handler.ts"
    },
    "./supercell": {
      "types": "./src/supercell.ts",
      "default": "./src/supercell.ts"
    },
    "./test/server-only-stub": {
      "types": "./src/test/server-only-stub.ts",
      "default": "./src/test/server-only-stub.ts"
    }
