# Last.fm API key (required)
# Create one at https://www.last.fm/api/account/create
# Only the key is needed -- every method this app calls is documented as
# "This service does not require authentication". The shared secret is for
# write operations (scrobbling, loving tracks) and is deliberately not used.
LASTFM_API_KEY=your_lastfm_api_key_here

# The Last.fm account to analyse (required)
LASTFM_USERNAME=your_lastfm_username

# IANA timezone used to bucket scrobbles into local hours and days (optional)
# Scrobbles are stored in UTC; this only affects how they are grouped.
LASTFM_TIMEZONE=America/Sao_Paulo

# Postgres connection string (required)
# Tables live in a dedicated `lastfm` schema, so this can safely share a
# database with another app.
POSTGRES_URL=your_postgres_connection_string_here

# Logging (optional, defaults: info in prod, debug in dev)
LOG_LEVEL=info
